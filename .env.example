# Hostinger ഇമെയിൽ ക്രഡൻഷ്യലുകൾ
HOSTINGER_IMAP_HOST=imap.hostinger.com
HOSTINGER_IMAP_PORT=993

# നിങ്ങളുടെ പ്രധാന Hostinger ഇമെയിലും പാസ്‌വേർഡും
HOSTINGER_EMAIL=your-main-email@yourdomain.com
HOSTINGER_PASSWORD=your-email-password

# നിങ്ങളുടെ ഡൊമെയ്ൻ പേര് (ഉദാഹരണത്തിന്: yourdomain.com)
DOMAIN=yourdomain.com

# ബ്രൗസർ സ്ക്രീനിൽ കാണണോ വേണ്ടയോ (false = സ്ക്രീനിൽ ബ്രൗസർ കാണാം, true = ബാക്ക്ഗ്രൗണ്ടിൽ നടക്കും)
HEADLESS=false
